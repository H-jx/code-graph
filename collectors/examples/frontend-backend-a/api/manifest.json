{
  "protocolVersion": "1.0",
  "pluginId": "example.a.api",
  "version": "1.0.0",
  "capabilities": [
    "api"
  ],
  "runtime": {
    "kind": "node",
    "versionRange": ">=24 <25"
  },
  "artifacts": [
    "manifest.json",
    "conventions.json",
    "cases/api.json",
    "cases/input.json",
    "cases/truth.json",
    "frontend-ast.mjs",
    "api-ast.mjs",
    "identity.mjs",
    "deps/package.json",
    "deps/package-lock.json",
    "collect.mjs"
  ],
  "dependencies": {
    "kind": "npm",
    "manifest": "deps/package.json",
    "lockFile": "deps/package-lock.json"
  },
  "stages": [
    {
      "id": "extract",
      "phase": "extract",
      "entry": "collect.mjs",
      "replacement": "project",
      "sourceSelectors": [
        {
          "id": "backend",
          "repositoryIds": [
            "back"
          ],
          "include": [
            "**/*.ts",
            "**/*.js",
            "**/*.py"
          ]
        }
      ]
    }
  ],
  "acceptanceCases": [
    "cases/api.json"
  ]
}
