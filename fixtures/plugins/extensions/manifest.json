{
  "protocolVersion": "1.0",
  "pluginId": "smoke.plugin",
  "version": "1.0.0",
  "runtime": { "kind": "node", "versionRange": ">=24 <25" },
  "artifacts": ["manifest.json", "collect.mjs"],
  "extensions": {
    "entities": [
      {
        "name": "x.smoke.plugin.invoice",
        "identityComponents": [
          { "name": "scopeId", "required": true },
          { "name": "semanticKey", "required": true },
          { "name": "catalog", "required": false }
        ],
        "attributesSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total"],
          "properties": {
            "total": { "$ref": "#/$defs/Amount" },
            "source": { "$ref": "#/$defs/Source" }
          },
          "$defs": { "Amount": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" } }
        }
      }
    ],
    "relations": [
      {
        "name": "x.smoke.plugin.binds",
        "allowedFrom": ["file"],
        "allowedTo": ["x.smoke.plugin.invoice"],
        "qualifiersSchema": {
          "type": "object",
          "required": ["role"],
          "properties": { "role": { "const": "original" } },
          "additionalProperties": false
        }
      }
    ]
  },
  "stages": [
    {
      "id": "extract",
      "phase": "extract",
      "entry": "collect.mjs",
      "args": [],
      "replacement": "project",
      "sourceSelectors": [{ "id": "sources", "include": ["**/*.ts"] }],
      "entitySelectors": [{ "id": "targets", "kinds": ["file", "x.smoke.plugin.invoice"] }],
      "dependsOn": []
    },
    {
      "id": "link",
      "phase": "link",
      "entry": "collect.mjs",
      "args": [],
      "replacement": "project",
      "sourceSelectors": [{ "id": "sources", "include": ["**/*.ts"] }],
      "entitySelectors": [{ "id": "targets", "kinds": ["file", "x.smoke.plugin.invoice"] }],
      "dependsOn": ["smoke.plugin:extract"]
    }
  ]
}
