{
  "schemaVersion": 1,
  "projectId": "acceptance.b",
  "repositories": [
    {
      "id": "front",
      "root": "client/ui"
    },
    {
      "id": "back",
      "root": "server/domain"
    }
  ],
  "selection": {},
  "scopes": [
    {
      "id": "app.web",
      "repositoryIds": [
        "front"
      ],
      "kind": "application"
    },
    {
      "id": "svc.erp",
      "repositoryIds": [
        "back"
      ],
      "kind": "service"
    }
  ],
  "services": [
    {
      "id": "erp",
      "scopeId": "svc.erp",
      "protocol": "http",
      "baseUrls": [
        "/erp"
      ]
    }
  ],
  "dataSources": [
    {
      "id": "ds.erp",
      "scopeId": "svc.erp",
      "dialect": "sqlite"
    },
    {
      "id": "ds.analytics",
      "scopeId": "svc.erp",
      "dialect": "sqlite"
    }
  ],
  "bindings": [
    {
      "id": "erp-client",
      "kind": "clientToService",
      "scopeId": "app.web",
      "from": "http",
      "to": "erp"
    }
  ]
}
