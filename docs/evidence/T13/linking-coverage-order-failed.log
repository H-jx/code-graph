r.tenant_id=p.tenant_id AND r.purchase_no=p.purchase_no AND r.line_no=p.line_no\\nLEFT JOIN t ON t.tenant_id=p.tenant_id AND t.purchase_no=p.purchase_no AND t.line_no=p.line_no\\nLEFT JOIN i ON i.tenant_id=p.tenant_id AND i.purchase_no=p.purchase_no AND i.line_no=p.line_no\\nWHERE p.tenant_id=:tenant AND p.status='APPROVED' ORDER BY p.purchase_no,p.line_no;\\n\"},\"timeFields\":{\"gapIds\":[\"gap_30b34f1fe509b4e838cf004e84b9886cc77cd202626f9afb63229c81696e1984\"],\"status\":\"unknown\"},\"units\":{\"gapIds\":[\"gap_30b34f1fe509b4e838cf004e84b9886cc77cd202626f9afb63229c81696e1984\"],\"status\":\"unknown\"},\"validStates\":{\"gapIds\":[\"gap_30b34f1fe509b4e838cf004e84b9886cc77cd202626f9afb63229c81696e1984\"],\"status\":\"unknown\"}}")], Array [String("ent_8a1366baae405d99d83ad16190077127cf644a6f11535c6db268b9b23a59b6f1"), String("symbol"), String("repo.back"), String("core.base"), String("wrongInstance"), String("{\"lexicalPath\":\"wrongInstance\",\"name\":\"wrongInstance\",\"normalizedSignature\":\"functionwrongInstance(){returnanalytics.query('SELECT tenant_id FROM purchase_detail');}\",\"path\":\"database.ts\",\"symbolKind\":\"function\"}")], Array [String("ent_8abc5cafb158a154b282270c4dd509fb0bfe5846c204012e17fb7d0b7eee87e4"), String("dataColumn"), String("svc.erp"), String("example.a.database@1.0.0:73629f90010883dbfaf87541014cefaa28b247c8ae4d3def187c6d1064da719f:extract"), String("id"), String("{\"dataType\":\"TEXT\",\"nullable\":\"unknown\"}")], Array [String("ent_8b27954a29c514b5d831f80ffaa68bca921b9999ed85337ddfb00615c7d9f25a"), String("queryImplementation"), String("svc.erp"), String("example.a.database@1.0.0:73629f90010883dbfaf87541014cefaa28b247c8ae4d3def187c6d1064da719f:extract"), String("back:fanout.sql:0"), String("{\"aggregates\":{\"gapIds\":[\"gap_cb80765d0ec9ee0559e10c552070d43c21a95faca2f5fb6b3fa4e834d1b8cfb7\"],\"status\":\"unknown\"},\"dialect\":\"sqlite\",\"grainColumnIds\":{\"gapIds\":[\"gap_cb80765d0ec9ee0559e10c552070d43c21a95faca2f5fb6b3fa4e83