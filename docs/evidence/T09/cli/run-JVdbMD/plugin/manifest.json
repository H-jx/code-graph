{
  "protocolVersion": "1.0",
  "pluginId": "smoke.plugin",
  "version": "1.0.0",
  "runtime": {
    "kind": "node",
    "versionRange": ">=24 <25"
  },
  "artifacts": [
    "manifest.json",
    "collect.mjs"
  ],
  "stages": [
    {
      "id": "extract",
      "phase": "extract",
      "entry": "collect.mjs",
      "args": [],
      "replacement": "project",
      "sourceSelectors": [
        {
          "id": "sources",
          "include": [
            "**/*.ts"
          ]
        }
      ],
      "entitySelectors": [
        {
          "id": "targets",
          "kinds": [
            "route",
            "file"
          ]
        }
      ],
      "dependsOn": []
    },
    {
      "id": "link",
      "phase": "link",
      "entry": "collect.mjs",
      "args": [
        "--bad"
      ],
      "replacement": "project",
      "sourceSelectors": [
        {
          "id": "sources",
          "include": [
            "**/*.ts"
          ]
        }
      ],
      "entitySelectors": [
        {
          "id": "targets",
          "kinds": [
            "route",
            "file"
          ]
        }
      ],
      "dependsOn": [
        "smoke.plugin:extract"
      ]
    }
  ]
}